{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@utils/*": [
        "./utils*"
      ],
      "@components/*": [
        "./components*"
      ],
      "@constants/*": [
        "./constants*"
      ],
      "@supabase/*": [
        "./supabase/*"
      ],
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}